# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/.conversation

# Foundry build output is reproducible and not needed in a web deployment.
artifacts/monarch-lens/contracts/out
artifacts/monarch-lens/contracts/cache
artifacts/monarch-lens/contracts/broadcast
