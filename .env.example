# ==============================================================================
# Monarch Lens — Environment Variables Template
# ==============================================================================
# Copy this file to .env (or .env.local) to override default configurations.
# NEVER commit private keys or sensitive credentials to source control.

# --- Web Application (artifacts/monarch-lens) ---
# Default port for development server (default: 5173)
PORT=5173

# Base URL path for deployment (default: /)
BASE_PATH=/

# --- Monad Testnet Settings ---
# Chain ID: 10143
# Public RPC: https://testnet-rpc.monad.xyz
# MonadVision Explorer: https://testnet.monadvision.com
# Monadscan Explorer: https://testnet.monadscan.com
# Monad Faucet: https://faucet.monad.xyz/

# --- Smart Contract Deployment (Foundry CLI / Optional) ---
# Dedicated testnet-only deployer private key (do NOT use a mainnet key).
# Only needed when deploying ReportRegistry.sol from the terminal via forge script.
# The web interface also supports deploying directly via your connected browser wallet (e.g. MetaMask).
# MONAD_TESTNET_PRIVATE_KEY=0x...

# --- Backend API Server (artifacts/api-server / Optional) ---
# Only needed if running the supplementary backend services.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monarch_lens
